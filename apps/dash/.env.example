# Copy to apps/dash/.env.local (git-ignored). Next.js reads env from this folder,
# not from the repo root.

# --- API ---------------------------------------------------------------------------
# Shown in curl samples and docs. The browser never calls it directly: every
# request goes through the same-origin /api/sf proxy, which attaches credentials.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the proxy (server side) reaches the API, if different from the above
# (e.g. http://api:8000 inside docker compose). Defaults to NEXT_PUBLIC_API_URL.
SF_API_URL=

# --- Feedback ----------------------------------------------------------------------
# Where "Send feedback" in the user menu drafts an email to. Leave empty to hide it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Development without WorkOS ----------------------------------------------------
# Set to an API key (sfk_test_...) and the dashboard skips sign-in: the proxy sends
# this key on every request, and the dashboard shows that key's environment.
# Read only on the server (proxy and route handlers); never bundled for the
# browser. NEXT_PUBLIC_SF_DEV_API_KEY is accepted as an alias for older setups.
# Leave empty to use WorkOS.
SF_DEV_API_KEY=

# --- WorkOS AuthKit (same values as the root .env) ---------------------------------
# dashboard.workos.com -> API Keys
WORKOS_API_KEY=                 # sk_test_...
WORKOS_CLIENT_ID=               # client_...
# Must also be listed under Redirects in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Encrypts the session cookie. At least 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Override only for testing against a WorkOS mock.
# WORKOS_API_URL=https://api.workos.com
