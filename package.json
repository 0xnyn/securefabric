{
  "name": "securefabric",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-generated": "turbo run check-generated",
    "check-tokens": "turbo run check-tokens",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:dash": "turbo run dev --filter=dash --filter=@securefabric/client",
    "dev:worker": "turbo run dev --filter=worker",
    "fix": "ultracite fix",
    "format": "ultracite fix && uv run ruff format . && uv run ruff check --select I --fix .",
    "generate": "pnpm -F @securefabric/client generate",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint typecheck test check-generated check-tokens && ultracite check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@securefabric/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.1.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}
