# Copy to .env (`make env`). Real environment variables always win over this file.
# Docker Compose injects its own DATABASE_URL pointing at the `postgres` service.

# --- Postgres (shared by every service) --------------------------------------
DATABASE_URL=postgresql://securefabric:securefabric@localhost:5432/securefabric
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
# Integration tests use a separate database (created automatically).
TEST_DATABASE_URL=postgresql://securefabric:securefabric@localhost:5432/securefabric_test

# --- Compose knobs -------------------------------------------------------------
POSTGRES_USER=securefabric
POSTGRES_PASSWORD=securefabric
POSTGRES_DB=securefabric
POSTGRES_PORT=5432
API_PORT=8000
HABITAT_PORT=7890

# --- API (API_*) ---------------------------------------------------------------
API_ENVIRONMENT=local          # local | test | staging | production
API_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_LOG_LEVEL=INFO
API_LOG_FORMAT=console         # console | json
API_DOCS_ENABLED=true
API_CORS_ORIGINS=["http://localhost:3000"]   # JSON list; the dash (apps/dash) in dev

# --- Worker (WORKER_*) ---------------------------------------------------------
WORKER_ENVIRONMENT=local
WORKER_LOG_LEVEL=INFO
WORKER_LOG_FORMAT=console
WORKER_QUEUE=default
WORKER_CONCURRENCY=4
WORKER_CLAIM_TIMEOUT=120
WORKER_POLL_INTERVAL=0.25
WORKER_AUTO_CREATE_QUEUE=true
WORKER_QUEUE_CLEANUP_TTL=30 days
WORKER_QUEUE_CLEANUP_LIMIT=1000

# --- Absurd client defaults (ABSURD_*) ----------------------------------------
ABSURD_DEFAULT_QUEUE=default
ABSURD_DEFAULT_MAX_ATTEMPTS=5

# --- Dash (apps/dash, Next.js) --------------------------------------------------
# Next reads env from apps/dash/.env*, not this file. The default below is what
# apps/dash/src/lib/api.ts falls back to; override it in apps/dash/.env.local.
# NEXT_PUBLIC_API_URL=http://localhost:8000
DASH_PORT=3000

# ==============================================================================
# Platform build (docs/plan). Nothing reads the variables below yet; they are the
# names the platform code will use. Lines marked [YOU] need a signup or a click
# in a vendor UI. Lines marked [GEN] are random local secrets: generate each with
#   openssl rand -base64 32
# ==============================================================================

# --- Region and public URLs ----------------------------------------------------
REGION=us                       # baked into API key prefixes (sfk_test_us_...)
# [YOU] Public https URL that tunnels to the local API (port 8000). GitHub needs
# it for webhooks and the install callback. ngrok or cloudflared with a stable
# hostname, e.g. `ngrok http --url=<your-reserved-domain> 8000`.
PUBLIC_API_URL=
PUBLIC_DASH_URL=http://localhost:3000

# --- WorkOS (dashboard login) ----------------------------------------------------
# [YOU] dashboard.workos.com -> create account -> enable AuthKit (staging env).
# Under Redirects add http://localhost:3000/callback. Values are on "API Keys".
WORKOS_API_KEY=                 # sk_test_...
WORKOS_CLIENT_ID=               # client_...
# The dashboard needs these too: copy apps/dash/.env.example to apps/dash/.env.local.

# --- Vault and signing keys (local dev) ------------------------------------------
VAULT_KEY_PROVIDER=local        # local | aws_kms (production, later)
VAULT_MASTER_KEY=               # [GEN] wraps each environment's private key. Workers only.
INGRESS_KEY=                    # [GEN] encrypts inbound-webhook secrets. API only.
API_KEY_PEPPER=                 # [GEN] HMAC pepper for hashing API keys
CURSOR_SIGNING_KEY=             # [GEN] signs pagination cursors

# --- Object storage (raw page archive) -------------------------------------------
# Defaults match the MinIO service that will be added to compose.yaml. No signup.
BLOB_ENDPOINT=http://localhost:9000
BLOB_BUCKET=securefabric-raw
BLOB_ACCESS_KEY=minioadmin
BLOB_SECRET_KEY=minioadmin
BLOB_REGION=us-east-1

# --- GitHub test organization ----------------------------------------------------
# [YOU] Free org: github.com/account/organizations/new. Keep it separate from real
# work: the seed tool fills it with deliberately vulnerable repos and test secrets.
GITHUB_TEST_ORG=
# [YOU] Fine-grained token: github.com/settings/personal-access-tokens
#   Resource owner: the test org. Repository access: all repositories.
#   Read and write: Administration, Contents, Code scanning alerts,
#   Secret scanning alerts, Dependabot alerts.
GITHUB_SEED_TOKEN=              # github_pat_...

# --- GitHub App: read-only, platform-owned ---------------------------------------
# [YOU] Test org -> Settings -> Developer settings -> GitHub Apps -> New GitHub App
#   Callback URL:   <PUBLIC_API_URL>/v1/connect/callback/github
#   Check:          "Request user authorization (OAuth) during installation"
#   Webhook URL:    <PUBLIC_API_URL>/v1/ingress/github/default   (updated later)
#   Webhook secret: the GITHUB_APP_WEBHOOK_SECRET value below
#   Repository permissions (read-only): Metadata, Code scanning alerts,
#     Secret scanning alerts, Dependabot alerts, Administration
#   Subscribe to events: Code scanning alert, Secret scanning alert,
#     Secret scanning alert location, Dependabot alert, Repository,
#     Security and analysis, Installation target
#   Where can this be installed: Any account
# Then on the app's page: "Generate a new client secret" and "Generate a private key".
GITHUB_APP_BASE_URL=https://github.com
GITHUB_APP_ID=                  # numeric, top of the app's settings page
GITHUB_APP_SLUG=                # the name in github.com/apps/<slug>
GITHUB_APP_CLIENT_ID=           # Iv1... or Iv23...
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=      # [GEN] must match what you typed into the app form
# Absolute path to the downloaded .pem. Keep it OUTSIDE this repo.
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Later milestones (leave blank for now) --------------------------------------
# M8: free key from nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# M9: a second GitHub App, same steps as above, but with READ AND WRITE on the three
# alert permissions. Used only for write-back.
GITHUB_APP_RW_ID=
GITHUB_APP_RW_SLUG=
GITHUB_APP_RW_CLIENT_ID=
GITHUB_APP_RW_CLIENT_SECRET=
GITHUB_APP_RW_WEBHOOK_SECRET=
GITHUB_APP_RW_PRIVATE_KEY_PATH=
# M9: a GHE.com or GitHub Enterprise Server trial, for testing customer-owned apps.
GHE_TEST_BASE_URL=              # e.g. https://acme.ghe.com
