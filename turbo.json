{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    ".python-version",
    "conftest.py",
    "pyproject.toml",
    "uv.lock",
    "tsconfig.json",
    "biome.json"
  ],
  "globalEnv": ["CI", "NODE_ENV", "NEXT_PUBLIC_API_URL"],
  "globalPassThroughEnv": ["UV_*", "TURBO_*", "FORCE_COLOR"],
  "tasks": {
    "//#check": {},
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VERCEL_PROJECT_PRODUCTION_URL", "VERCEL_URL", "PORT"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "env": ["TEST_DATABASE_URL"]
    },
    "check-generated": {
      "dependsOn": ["^transit"],
      "inputs": ["src/v1.ts", "package.json"]
    },
    "check-tokens": {
      "inputs": ["src/**", "scripts/**", "DESIGN.md"]
    },
    "generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}
